        },
        {
          "label": "Contractor registration",
          "type": "note",
          "value": "Fire alarm contractors must be registered with TDI-SFMO and with the City of Houston; permit applications are filed through iPermits."
        }
      ]
    },
    {
      "id": "harris-county",
      "title": "Outside Houston city limits",
      "items": [
        {
          "label": "Know your AHJ",
          "type": "note",
          "value": "Unincorporated Harris County is handled by the Harris County Fire Marshal's Office. Cities such as Pasadena, Baytown, Pearland, Sugar Land, and Katy each have their own fire marshal permits and plan review. Confirm the AHJ before every job."
        }
      ]
    }
  ]
